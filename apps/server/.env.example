# Database (Supabase). The direct host db.<ref>.supabase.co is IPv6-only now,
# so on IPv4 networks use the POOLER endpoints (...pooler.supabase.com), both IPv4.
#
# DATABASE_URL = Transaction pooler (port 6543) for app runtime. Append pgbouncer flag.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL = Session pooler (port 5432) for prisma migrate / DDL.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# AI provider (OpenAI-compatible).
# Default: leave AI_BASE_URL blank and set GROQ_API_KEY to use Groq directly.
GROQ_API_KEY=

# To use PhanRouter (or any OpenAI-compatible gateway) instead of Groq,
# set these three. AI_API_KEY takes priority over GROQ_API_KEY.
#   AI_BASE_URL — gateway base, e.g. https://www.phanrouter.com/v1
#   AI_API_KEY  — your PhanRouter key (sk-...)
#   AI_MODEL    — a model name shown in the PhanRouter dashboard
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=

# Public base URL where this backend is reachable. Used by the webhook setup script.
# Local dev: ngrok URL (e.g. https://abc123.ngrok-free.app)
# Production: your Vercel deployment URL (e.g. https://twitter-copilot.vercel.app)
PUBLIC_URL=

# Random string. Telegram sends it back as X-Telegram-Bot-Api-Secret-Token on every webhook call.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Random string. Required as `Authorization: Bearer <CRON_SECRET>` for POST /cron/tick.
# Generate: openssl rand -hex 32
CRON_SECRET=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Reddit — strongly recommended. Without these, Reddit returns 403 for the
# public .json endpoint (datacenter IPs / generic clients are blocked).
# Create a "script" app at https://www.reddit.com/prefs/apps to get id + secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: override the User-Agent. Reddit prefers: <platform>:<appid>:<ver> (by /u/<you>)
REDDIT_USER_AGENT=
