# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Groq AI
GROQ_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Cron schedule for content generation (default: 9am and 7pm daily)
# Set to "*/2 * * * *" during testing to trigger every 2 minutes.
CRON_SCHEDULE=0 9,19 * * *

# Reddit (optional, increases rate limits)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
