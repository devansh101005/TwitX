# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Groq AI
GROQ_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=

# Public base URL where this backend is reachable. Used by the webhook setup script.
# Local dev: ngrok URL (e.g. https://abc123.ngrok-free.app)
# Production: your Vercel deployment URL (e.g. https://twitter-copilot.vercel.app)
PUBLIC_URL=

# Random string. Telegram sends it back as X-Telegram-Bot-Api-Secret-Token on every webhook call.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Random string. Required as `Authorization: Bearer <CRON_SECRET>` for POST /cron/tick.
# Generate: openssl rand -hex 32
CRON_SECRET=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Reddit (optional, increases rate limits)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
